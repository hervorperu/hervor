# ==========================================================
# Variables de entorno del Libro de Reclamaciones de Hervor
# Copia este archivo como .env.local (local) y crea las mismas
# variables en Vercel → Project → Settings → Environment Variables.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# ==========================================================

# --- Sitio ---
# URL pública de la web (se usa para el logo de los correos)
SITE_URL=https://www.tudominio.pe

# --- Almacenamiento ---
# "supabase" en producción. "memory" solo para pruebas locales (no guarda nada).
STORAGE_DRIVER=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → service_role (SECRETA)
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo ---
# "smtp" (Gmail hoy) | "resend" (con dominio propio) | "outbox" (solo pruebas locales)
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=Hervor
# Con Gmail debe ser la misma cuenta que SMTP_USER
MAIL_FROM_ADDRESS=
# Opcional: dirección a la que responden los consumidores
MAIL_REPLY_TO=
# Correo que recibe la alerta de cada reclamo
OWNER_EMAIL=

# SMTP (Gmail con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Contraseña de aplicación de 16 caracteres, sin espacios
SMTP_PASS=

# Resend (cuando haya dominio propio)
RESEND_API_KEY=

# --- Seguridad ---
# Texto aleatorio largo; Vercel lo envía al ejecutar el cron diario
CRON_SECRET=
# Contraseña para descargar hojas con tu respuesta (/api/admin/hoja)
ADMIN_PASSWORD=
